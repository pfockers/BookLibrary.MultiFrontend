<Window x:Class="BookLibrary.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Book Library - WPF" Height="600" Width="1000">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <UniformGrid Columns="4" Margin="0,0,0,12">
            <StackPanel Margin="4"><TextBlock Text="Title"/><TextBox Text="{Binding NewBook.Title, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Margin="4"><TextBlock Text="Author"/><TextBox Text="{Binding NewBook.Author, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Margin="4"><TextBlock Text="ISBN"/><TextBox Text="{Binding NewBook.Isbn, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Margin="4"><TextBlock Text="Genre"/><TextBox Text="{Binding NewBook.Genre, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        </UniformGrid>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Books}" AutoGenerateColumns="True" IsReadOnly="True"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Add book" Command="{Binding AddCommand}" Padding="18,6"/>
            <Button Content="Delete selected" Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedItem, ElementName=booksGrid}" Margin="8,0,0,0" Padding="18,6"/>
            <TextBlock Text="{Binding Status}" Margin="16,6,0,0"/>
        </StackPanel>
    </Grid>
</Window>
