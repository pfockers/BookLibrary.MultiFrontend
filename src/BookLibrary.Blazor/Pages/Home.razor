@page "/"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Book Library - Blazor</PageTitle>
<section class="intro">
    <div>
        <p class="eyebrow">PERSONAL COLLECTION</p>
        <h1>Your library, <span>well kept.</span></h1>
        <p class="intro-copy">Keep your favorite reads close, and make space for the next one.</p>
    </div>
    <div class="collection-count"><strong>@(books?.Count ?? 0)</strong><span>books in<br />your collection</span></div>
</section>

<section class="panel add-panel" aria-labelledby="add-heading">
    <div class="panel-heading">
        <div><p class="eyebrow">GROW YOUR SHELF</p><h2 id="add-heading">Add a book</h2></div>
        <span class="step-mark" aria-hidden="true">01</span>
    </div>
    <EditForm Model="newBook" OnValidSubmit="AddBook" class="book-form">
        <label class="field"><span>Title</span><InputText class="form-control" @bind-Value="newBook.Title" placeholder="e.g. The Secret Garden" required /></label>
        <label class="field"><span>Author</span><InputText class="form-control" @bind-Value="newBook.Author" placeholder="Author name" required /></label>
        <label class="field"><span>ISBN</span><InputText class="form-control" @bind-Value="newBook.Isbn" placeholder="978-…" /></label>
        <label class="field"><span>Genre</span><InputText class="form-control" @bind-Value="newBook.Genre" placeholder="e.g. Fiction" /></label>
        <label class="field year-field"><span>Published year</span><InputNumber class="form-control" @bind-Value="newBook.PublishedYear" /></label>
        <label class="availability-field"><InputCheckbox @bind-Value="newBook.IsAvailable" /><span>Available to borrow</span></label>
        <button class="primary-button" type="submit"><span aria-hidden="true">+</span> Add book</button>
    </EditForm>
</section>

@if (!string.IsNullOrEmpty(error)) { <p class="error-message" role="alert">@error</p> }

<section class="collection-section" aria-labelledby="collection-heading">
    <div class="collection-heading">
        <div><p class="eyebrow">THE GOOD READS</p><h2 id="collection-heading">Your collection</h2></div>
        <span class="result-count">@(books?.Count ?? 0) BOOKS</span>
    </div>
    @if (books is null) { <div class="table-card empty-state">Loading your collection…</div> }
    else {
        <div class="table-card"><div class="table-scroll"><table class="book-table">
            <thead><tr><th>Title</th><th>Author</th><th>ISBN</th><th>Genre</th><th>Year</th><th>Availability</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
                @if (books.Count == 0) { <tr><td class="empty-state" colspan="7">Your shelf is waiting. Add your first book above.</td></tr> }
                @foreach (var book in books) {
                    <tr>
                        <td class="book-title">@book.Title</td><td>@book.Author</td><td class="isbn-cell">@book.Isbn</td><td><span class="genre-tag">@book.Genre</span></td><td>@book.PublishedYear</td>
                        <td><span class="availability @(book.IsAvailable ? "is-available" : "is-unavailable")"><span></span>@(book.IsAvailable ? "Available" : "On loan")</span></td>
                        <td><button class="delete-button" @onclick="() => DeleteBook(book.Id)">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table></div></div>
    }
</section>

@code {
    private List<Book>? books;
    private Book newBook = new();
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadBooks();
    private async Task LoadBooks() => books = await Http.GetFromJsonAsync<List<Book>>("api/books") ?? [];
    private async Task AddBook() { try { error = null; var response = await Http.PostAsJsonAsync("api/books", newBook); response.EnsureSuccessStatusCode(); newBook = new(); await LoadBooks(); } catch (Exception ex) { error = ex.Message; } }
    private async Task DeleteBook(int id) { await Http.DeleteAsync($"api/books/{id}"); await LoadBooks(); }
}
